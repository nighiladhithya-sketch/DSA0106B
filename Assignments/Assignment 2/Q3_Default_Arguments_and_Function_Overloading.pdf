(// Q3: Courier charge calculator - redesigned: defaults for short calls, overloads for different input kinds) Tj
T*
(#include <iostream>) Tj
T*
T*
(struct Parcel { double kg; bool fragile; };) Tj
T*
T*
(const double RATE_PER_KG = 50, EXPRESS_FEE = 40, INSURE_FEE = 25;) Tj
T*
T*
(// Defaults only on the LAST overload group, one default-carrying function per parameter-type signature) Tj
T*
(double charge\(double kg, bool express = false, bool insured = false\) {          // \(2\)) Tj
T*
(    std::cout << "[double kg] ";) Tj
T*
(    return kg * RATE_PER_KG + \(express ? EXPRESS_FEE : 0\) + \(insured ? INSURE_FEE : 0\);) Tj
T*
(}) Tj
T*
(double charge\(int grams, bool express = false, bool insured = false\) {          // \(1\)) Tj
T*
(    std::cout << "[int grams] ";) Tj
T*
(    return \(grams / 1000.0\) * RATE_PER_KG + \(express ? EXPRESS_FEE : 0\) + \(insured ? INSURE_FEE : 0\);) Tj
T*
(}) Tj
T*
(double charge\(const Parcel& p, bool express = false, bool insured = false\) {    // \(3\)) Tj
T*
(    std::cout << "[Parcel] ";) Tj
T*
(    return p.kg * RATE_PER_KG + \(p.fragile ? 30 : 0\) + \(express ? EXPRESS_FEE : 0\) + \(insured ? INSURE_FEE : 0\);) Tj
T*
(}) Tj
T*
T*
(int main\(\) {) Tj
T*
(    // PREDICTIONS \(written before running\):) Tj
T*
(    // 1 charge\(2\)            -> int exact match            -> int grams   \(2 g\)   = 0.1) Tj
T*
(    // 2 charge\(2.0f\)         -> float->double PROMOTION wins over float->int CONVERSION -> double kg = 100) Tj
T*
(    // 3 charge\(2.5\)          -> exact double               -> double kg   = 125) Tj
T*
(    // 4 charge\(1500, true\)   -> int exact, bool exact      -> int grams   = 75+40 = 115) Tj
T*
(    // 5 charge\(Parcel{3,true}\) -> Parcel                   -> Parcel      = 150+30 = 180) Tj
T*
(    // 6 charge\(2.5, true, true\) -> double kg               -> 125+40+25 = 190) Tj
T*
(    std::cout << charge\(2\)               << '\\n';) Tj
T*
(    std::cout << charge\(2.0f\)            << '\\n';) Tj
T*
(    std::cout << charge\(2.5\)             << '\\n';) Tj
T*
(    std::cout << charge\(1500, true\)      << '\\n';) Tj
T*
(    std::cout << charge\(Parcel{3, true}\) << '\\n';) Tj
T*
(    std::cout << charge\(2.5, true, true\) << '\\n';) Tj
T*
(    // std::cout << charge\(2L\);          // would be AMBIGUOUS: long->int and long->double are both conversions) Tj
T*
(}) Tj

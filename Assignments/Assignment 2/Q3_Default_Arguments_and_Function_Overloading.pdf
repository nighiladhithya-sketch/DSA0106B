(// Alternative: one struct with optional fields \(new option = add a field, no new overload\)) Tj
T*
(#include <iostream>) Tj
T*
(struct Request { double kg = 0; bool express = false, insured = false, fragile = false; };) Tj
T*
(double charge\(const Request& r\) {) Tj
T*
(    return r.kg * 50 + \(r.fragile ? 30 : 0\) + \(r.express ? 40 : 0\) + \(r.insured ? 25 : 0\);) Tj
T*
(}) Tj
T*
(template <typename W>                       // alternative 2: template for any numeric weight) Tj
T*
(double chargeT\(W kg, bool express = false\)  { return static_cast<double>\(kg\) * 50 + \(express ? 40 : 0\); }) Tj
T*
(int main\(\) {) Tj
T*
(    std::cout << charge\({2.5, true, false, false}\) << '\\n';   // aggregate init \(C++14+\)) Tj
T*
(    Request r; r.kg = 3; r.fragile = true;                    // designated by field name: easy to extend) Tj
T*
(    std::cout << charge\(r\) << '\\n';) Tj
T*
(    std::cout << chargeT\(2\) << ' ' << chargeT\(2.5f, true\) << '\\n';) Tj
T*
(}) Tj
